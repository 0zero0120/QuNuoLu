class_name IconFactory
extends RefCounted
## Generates pixel art icon textures at runtime — no external PNGs needed.

const SIZE: int = 16
static var _cache: Dictionary = {}

# ── Color ───────────────────────────────────────────────────

static func _pal(chars: Dictionary, ch: String) -> Color:
	if chars.has(ch):
		return Color(chars[ch])
	return Color(0, 0, 0, 0)

