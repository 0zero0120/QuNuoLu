static func _build_texture(name: String) -> ImageTexture:
	var info: Dictionary = DESIGNS.get(name, {})
	var palette: Dictionary = info.get("palette", {})
	var rows: Array = info.get("rows", [])
	if rows.is_empty():
		return null

	var img := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	for y in range(SIZE):
		var row: String = rows[y]
		while row.length() < SIZE:
			row += "."
		for x in range(SIZE):
			var col := _pal(palette, row[x])
			img.set_pixel(x, y, col)

	var scaled := img.duplicate()
	scaled.resize(SIZE * 2, SIZE * 2, Image.INTERPOLATE_NEAREST)
	return ImageTexture.create_from_image(scaled)


static func get_icon(name: String) -> ImageTexture:
	if _cache.has(name):
		return _cache[name]
	var tex := _build_texture(name)
	if tex:
		_cache[name] = tex
	return tex
