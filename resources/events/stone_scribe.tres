[gd_resource type="Resource" script_class="EventData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/event_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/event_option.gd" id="2"]

[sub_resource type="Resource" id="Opt_erase"]
script = ExtResource("2")
label = "刻去一段旧字"
action = "remove_card"

[sub_resource type="Resource" id="Opt_rune"]
script = ExtResource("2")
label = "刻上一道护符"
action = "gain_max_hp"
value = 8.0

[sub_resource type="Resource" id="Opt_sit"]
script = ExtResource("2")
label = "让他刻下去"
action = "lose_hp"
value = 6.0
next_options = [SubResource("Opt_erase"), SubResource("Opt_rune")]

[sub_resource type="Resource" id="Opt_thanks"]
script = ExtResource("2")
label = "道声谢就走"

[resource]
script = ExtResource("1")
event_id = "stone_scribe"
title = "石匠"
text = "一个背对着你的石匠正在凿字，凿子起落很有节奏。他脚下堆满了凿下来的石屑，每一片上都带着半个字。"
options = [SubResource("Opt_sit"), SubResource("Opt_thanks")]
