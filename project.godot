; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="驱傩录"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon_nuo.png"

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
RelicManager="*res://scripts/autoload/relic_manager.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
EffectsManager="*res://scripts/autoload/effects_manager.gd"
MusicManager="*res://scripts/autoload/music_manager.gd"
UiFontScale="*res://scripts/autoload/ui_font_scale.gd"
FunplayMcpRuntimeBridge="*res://addons/funplay_mcp/runtime/funplay_mcp_runtime_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="毕设游戏项目"

[editor_plugins]

enabled=PackedStringArray("res://addons/funplay_mcp/plugin.cfg")

